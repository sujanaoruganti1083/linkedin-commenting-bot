# LinkedIn (via LinkUp API — https://linkupapi.com)
LINKUP_API_KEY=             # Your LinkUp API key
LINKUP_ACCOUNT_ID=          # Your account ID from the LinkUp dashboard

# Anthropic
ANTHROPIC_API_KEY=          # sk-ant-...

# Slack
SLACK_BOT_TOKEN=            # xoxb-...
SLACK_SIGNING_SECRET=       # From App Settings > Basic Information
SLACK_CHANNEL_ID=           # Channel ID where approval messages are sent

# Schedule (all times in PST / America/Los_Angeles)
FETCH_SCHEDULE=8:00,10:30,13:00,15:30,18:00
TIMEZONE=America/Los_Angeles
MAX_POSTS_PER_RUN=3
MAX_COMMENTS_PER_DAY=5
MIN_COMMENT_GAP_SECONDS=120

# LinkedIn identity
LINKEDIN_PERSON_URN=urn:li:member:{your_person_id}
